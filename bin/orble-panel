#!/usr/bin/env -S python3 -I
"""Backend for the thelaggingway.orble-helper Omarchy bar panel.

Everything the panel does goes through this script, which calls the
`orble` CLI with a fixed argv (never a shell string), so the CLI's own
sign-in is used and the plugin stores no token anywhere.

  orble-panel [--project <slug>] <command> ...
                                         any command below, in that Orble project (default: ORBLE_PROJECT,
                                         else the account's default project)
  orble-panel status                     boxes, snapshots, projects, account, SSH keys and local .pub keys (one JSON)
  orble-panel ports <box>                a box's shared ports (one JSON)
  orble-panel detail egress <box>       a box's outbound policy (one JSON)
  orble-panel detail networks|secrets   private networks or secret assignments (one JSON)
  orble-panel secret-set ...            launch the CLI prompt with validated metadata
  orble-panel action <verb> ...          run one action and send a desktop notification
  orble-panel exit-node [--lan] [--fallback] [box...]
                                         become `orble exit-node` (the panel stops it with SIGINT)
  orble-panel ssh <box>                  (in a terminal) orble ssh, resuming a suspended box
  orble-panel desktop <box>              (in a terminal) the box's desktop in a local VNC viewer
  orble-panel topup <dollars>            (in a terminal) orble topup, $10 to $500
  orble-panel login                      (in a terminal) orble login
  status | ports | exit-node ... --demo          made-up data for screenshots; never calls the CLI

Action verbs:
  suspend|resume|rm|vnc|desktop-off|keep-awake|keep-awake-off <box>
  new [s|m|l]
  new-from <snapshot> [s|m|l]
  fork <box> [1-10]
  snapshot <box> [name]
  snapshot-rm <snapshot>
  port|port-public|port-off <box> <port>
  keys-add <file.pub in ~/.ssh>
  keys-rm <SHA256:fingerprint>
  project-create <name>
  update
"""

import glob
import ipaddress
import json
import os
import re
import selectors
import shutil
import signal
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

CLI = shutil.which("orble") or os.path.expanduser("~/.local/bin/orble")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$")
# Project slugs (`orble project list`) and new project names (`orble project create <name>`).
PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
PROJECT_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._-]{0,39}$")
# `--project <slug>` given before the subcommand; every CLI call then carries it.
PROJECT = []
FP_RE = re.compile(r"^SHA256:[A-Za-z0-9+/]{43}$")
KEYFILE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\.pub$")
HOST_RE = re.compile(r"^[a-z0-9][a-z0-9.-]{0,200}\.orble\.tech$")
# Shared ports get their own address, like https://8080-yj3vcxk7lezdtgpc.orble.dev
PORT_URL_RE = re.compile(r"^https://[a-z0-9][a-z0-9.-]{0,200}\.orble\.(dev|tech)(/[A-Za-z0-9._~/-]{0,200})?$")
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07")
ENV = dict(os.environ, NO_COLOR="1", TERM="dumb")
SSH_DIR = os.path.expanduser("~/.ssh")
# Signed out, any orble command starts a browser sign-in. Seeing one of these ends the call.
AUTH_MARKERS = (b"Not signed in", b"Signing in", b"orble.tech/cli?code=")
VIEWERS = ("xtigervncviewer", "remmina")


def config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "orble", "config.json")


def signed_in():
    """True when the CLI has a stored sign-in or an ORBLE_API_KEY (the CLI uses either).
    Only their presence is checked; neither is ever read out."""
    if os.environ.get("ORBLE_API_KEY"):
        return True
    try:
        with open(config_path()) as f:
            d = json.load(f)
        return isinstance(d, dict) and bool(d.get("token"))
    except (OSError, ValueError):
        return False


def clean(text):
    return ANSI_RE.sub("", text).replace("\r", "\n")


def cli(args, timeout=60):
    """Run the CLI with no stdin. Returns (code, stdout, stderr); code 3 means it wanted to sign in."""
    try:
        p = subprocess.Popen([CLI, *PROJECT, *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, env=ENV)
    except (FileNotFoundError, PermissionError):
        return 127, "", "orble CLI not found"
    bufs = {p.stdout.fileno(): bytearray(), p.stderr.fileno(): bytearray()}
    sel = selectors.DefaultSelector()
    for fd in bufs:
        sel.register(fd, selectors.EVENT_READ)
    deadline = time.monotonic() + timeout
    code = None
    while sel.get_map():
        left = deadline - time.monotonic()
        if left <= 0:
            code = 124
            break
        for key, _ in sel.select(min(left, 1.0)):
            chunk = os.read(key.fd, 65536)
            if not chunk:
                sel.unregister(key.fd)
            elif len(bufs[key.fd]) < 1 << 20:
                bufs[key.fd] += chunk
        if any(m in b for b in bufs.values() for m in AUTH_MARKERS):
            code = 3
            break
    if code is not None:
        p.kill()
    rc = p.wait()
    out, err = (clean(bytes(bufs[f]).decode("utf-8", "replace")) for f in (p.stdout.fileno(), p.stderr.fileno()))
    p.stdout.close()
    p.stderr.close()
    if code == 124:
        return 124, out, "timed out"
    if code == 3:
        return 3, out, "Not signed in to Orble"
    return rc, out, err


def s(v, n=120):
    return str(v)[:n] if v is not None else ""


def last_lines(*texts, n=3):
    lines = [l.strip() for t in texts for l in t.splitlines() if l.strip()]
    return " ".join(lines[-n:])[:300]


# ---------- parsing the CLI's tables ----------

def parse_table(text):
    """Rows of a left-aligned table whose first line holds the column names, as dicts.
    Cells are cut at the header's column starts; anything past the last named column
    (after two spaces) is returned as the row's "extra" words."""
    lines = [l for l in clean(text).splitlines() if l.strip()]
    for i, line in enumerate(lines):
        if re.match(r"^NAME\s{2,}", line):
            header, rows = line, lines[i + 1:]
            break
    else:
        return []
    cols = [(m.group(), m.start()) for m in re.finditer(r"\S+", header)]
    out = []
    for row in rows[:200]:
        rec = {}
        for j, (name, start) in enumerate(cols):
            end = cols[j + 1][1] if j + 1 < len(cols) else None
            rec[name] = row[start:end].strip() if end else row[start:].strip()
        last = cols[-1][0]
        parts = re.split(r"\s{2,}", rec.get(last, ""))
        rec[last], rec["extra"] = parts[0], [p for p in parts[1:] if p]
        out.append(rec)
    return out


def parse_boxes(text):
    boxes = []
    for r in parse_table(text)[:100]:
        name = r.get("NAME", "")
        if not NAME_RE.match(name):
            continue
        state = re.sub(r"^[^A-Za-z]+", "", r.get("STATE", "")).strip().lower()
        # "s 2c/4g" since the CLI got sizes (adcd323c); "μ 1c/2g" for micro; plain "2c/4g" before.
        size = re.fullmatch(r"(?:(micro|μ|[sml])\s+)?(\d{1,3})c/(\d{1,4})g", r.get("SIZE", ""))
        size_cls = ("micro" if size[1] in ("micro", "μ") else size[1]) if (size and size[1]) else ""
        spent = re.fullmatch(r"\$(\d{1,7}(?:\.\d{1,6})?)", r.get("SPENT", ""))
        host = r.get("HOST", "")
        boxes.append({
            "name": name,
            "state": s(state, 32) if re.fullmatch(r"[a-z][a-z -]*", state or "") else "unknown",
            "host": host if HOST_RE.match(host) else "",
            "size": size_cls,
            "vcpus": int(size[2]) if size else 0,
            "memGiB": int(size[3]) if size else 0,
            "spentUSD": float(spent[1]) if spent else 0.0,
            "active": s(r.get("ACTIVE"), 24),
            "flags": [s(f, 24) for f in r.get("extra", [])[:4] if re.fullmatch(r"[A-Za-z][A-Za-z -]*", f)],
        })
    return boxes


SIZE_CLASS = {(1, 2): "micro", (2, 4): "s", (4, 8): "m", (8, 16): "l"}


def since(iso, now=None):
    """'now', '12m ago', '3h ago', '2d ago' from an RFC 3339 time, like the ls table's ACTIVE."""
    try:
        from datetime import datetime, timezone
        then = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
        d = int(((now or datetime.now(timezone.utc)) - then).total_seconds())
    except (TypeError, ValueError):
        return ""
    if d < 60:
        return "now"
    if d < 3600:
        return f"{d // 60}m ago"
    if d < 86400:
        return f"{d // 3600}h ago"
    return f"{d // 86400}d ago"


def fork_parent(b):
    """The box this one was forked from. `ls --json` hasn't been seen with a fork yet,
    so accept the likely field names and keep only a valid box name."""
    for k in ("forked_from", "forkedFrom", "parent", "fork_of"):
        v = b.get(k)
        if isinstance(v, dict):
            v = v.get("name")
        if isinstance(v, str) and NAME_RE.match(v):
            return v
    return ""


def parse_boxes_json(text):
    """`orble ls --json` (a list of boxes), or None when it isn't that."""
    try:
        data = json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return None
    if isinstance(data, dict):
        data = data.get("boxes")
    if not isinstance(data, list):
        return None
    boxes = []
    for b in data[:100]:
        if not isinstance(b, dict) or not NAME_RE.match(str(b.get("name") or "")):
            continue
        state = str(b.get("state") or "").lower()
        host = str(b.get("hostname") or "")
        try:
            vcpus = int(b.get("vcpus") or 0)
            mem = int(b.get("mem_mib") or 0) // 1024
            disk = int(b.get("disk_gib") or 0)
            spent = round(int(b.get("spent_micros") or 0) / 1e6, 6)
        except (TypeError, ValueError):
            vcpus = mem = disk = 0
            spent = 0.0
        boxes.append({
            "name": b["name"],
            "alias": b["alias"] if NAME_RE.fullmatch(str(b.get("alias") or "")) else "",
            "state": s(state, 32) if re.fullmatch(r"[a-z][a-z -]*", state) else "unknown",
            "host": host if HOST_RE.match(host) else "",
            "size": SIZE_CLASS.get((vcpus, mem), ""),
            "vcpus": vcpus,
            "memGiB": mem,
            "diskGiB": disk,
            "spentUSD": spent,
            "active": since(b.get("last_active_at")) if b.get("last_active_at") else "",
            "flags": ["desktop"] if b.get("desktop") is True else [],
            "forkedFrom": fork_parent(b),
            # The snapshot a box was made from (`orble new --from`), when ls --json has one.
            "fromSnapshot": b["snapshot"] if NAME_RE.fullmatch(str(b.get("snapshot") or "")) else "",
            "keepAwake": b.get("keep_awake") is True,
        })
    return fork_order(boxes)


def fork_order(boxes):
    """Each fork right after the box it came from (as `orble ls` shows them), else CLI order."""
    names = {b["name"] for b in boxes}
    kids = {}
    for b in boxes:
        if b["forkedFrom"] in names and b["forkedFrom"] != b["name"]:
            kids.setdefault(b["forkedFrom"], []).append(b)
    out, seen = [], set()

    def add(b, depth):
        if b["name"] in seen:
            return
        seen.add(b["name"])
        b["depth"] = min(depth, 3)
        out.append(b)
        for k in kids.get(b["name"], []):
            add(k, depth + 1)

    for b in boxes:
        if b["forkedFrom"] not in names or b["forkedFrom"] == b["name"]:
            add(b, 0)
    for b in boxes:  # anything left (a fork cycle) goes last
        add(b, 0)
    return out


def disk_text(n):
    """409100288 -> '409 MB', like `orble snapshots` (decimal units)."""
    if n >= 1e9:
        return f"{n / 1e9:.1f} GB"
    return f"{n / 1e6:.0f} MB"


def parse_snapshots_json(text):
    """`orble snapshots --json`: [{name, box, state, vcpus, mem_mib, disk_bytes, created_at}], or None."""
    try:
        data = json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return None
    if isinstance(data, dict):
        data = data.get("snapshots")
    if not isinstance(data, list):
        return None
    snaps = []
    for x in data[:100]:
        if not isinstance(x, dict) or not NAME_RE.match(str(x.get("name") or "")):
            continue
        box = str(x.get("box") or "")
        state = str(x.get("state") or "").lower()
        try:
            vcpus = int(x.get("vcpus") or 0)
            mem = int(x.get("mem_mib") or 0) // 1024
            disk = int(x.get("disk_bytes") or 0)
        except (TypeError, ValueError):
            vcpus = mem = disk = 0
        snaps.append({
            "name": x["name"],
            "gallery": x.get("gallery") is True,
            # Gallery entries describe themselves ("for E2B's code interpreter SDK").
            "about": s(re.sub(r"[\x00-\x1f\x7f]", " ", str(x.get("about") or "")), 80),
            "alias": x["alias"] if NAME_RE.fullmatch(str(x.get("alias") or "")) else "",
            "box": box if NAME_RE.match(box) else "",
            "state": s(state, 32) if re.fullmatch(r"[a-z][a-z -]*", state) else "unknown",
            "size": SIZE_CLASS.get((vcpus, mem), ""),
            "vcpus": vcpus,
            "memGiB": mem,
            "disk": disk_text(disk) if disk > 0 else "",
            "created": since(x.get("created_at")) if x.get("created_at") else "",
        })
    return snaps


def parse_ports(text):
    """`orble port <box>`: '8080   signin  https://8080-….orble.dev' per line, or 'no shared ports'."""
    ports = []
    for l in clean(text).splitlines()[:100]:
        m = re.match(r"^\s*(\d{1,5})\s+([a-z][a-z-]{0,23})\s+(\S+)\s*$", l)
        if m and 1 <= int(m[1]) <= 65535 and PORT_URL_RE.match(m[3]):
            ports.append({"port": int(m[1]), "access": m[2], "url": m[3]})
    return ports


def parse_account(text):
    lines = [l for l in clean(text).splitlines() if l.strip()]
    acct = {"email": "", "domain": "", "creditUSD": None, "keys": 0}
    if not lines:
        return acct
    acct["email"] = s(lines[0].strip(), 120)
    for l in lines[1:]:
        m = re.match(r"^\s+([a-z][a-z ]*?)\s{2,}(\S.*)$", l)
        if not m:
            continue
        k, v = m[1], m[2].strip()
        if k == "plan":
            acct["plan"] = s(v, 80)
        elif k == "boxes":
            d = re.fullmatch(r"<box>\.([a-z0-9-]{1,63})\.orble\.tech", v)
            acct["domain"] = d[1] if d else ""
        elif k == "credit":
            c = re.fullmatch(r"-?\$(\d{1,7}(?:\.\d{1,6})?)", v)
            acct["creditUSD"] = (-1 if v.startswith("-") else 1) * float(c[1]) if c else None
        elif k == "keys" and re.fullmatch(r"\d{1,4}", v):
            acct["keys"] = int(v)
    return acct


def parse_keys(text):
    keys = []
    for l in clean(text).splitlines()[:100]:
        m = re.match(r"^(.*?)\s+(SHA256:[A-Za-z0-9+/]{43})\s*$", l)
        if m:
            keys.append({"name": s(m[1].strip(), 64), "fingerprint": m[2]})
    return keys


def local_keys(uploaded):
    """Public keys in ~/.ssh with their fingerprints; `added` marks the ones already on the account."""
    out = []
    for path in sorted(glob.glob(os.path.join(SSH_DIR, "*.pub")))[:20]:
        base = os.path.basename(path)
        if not KEYFILE_RE.match(base) or not os.path.isfile(path):
            continue
        try:
            p = subprocess.run(["ssh-keygen", "-lf", path], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            continue
        m = re.match(r"^\d+\s+(SHA256:[A-Za-z0-9+/]{43})\s+(.*?)\s+\(([A-Z0-9-]+)\)\s*$", p.stdout.strip())
        if p.returncode == 0 and m:
            out.append({"file": base, "fingerprint": m[1], "comment": s(m[2], 64), "type": s(m[3], 16),
                        "added": m[1] in uploaded})
    return out


def parse_projects(text):
    """`orble project list`: '<slug>  <Name>' per line."""
    projects = []
    for l in clean(text).splitlines()[:50]:
        m = re.match(r"^([a-z0-9][a-z0-9-]{0,62})\s{2,}(\S.*?)\s*$", l)
        if m:
            projects.append({"slug": m[1], "name": s(m[2], 40)})
    return projects


def current_project():
    """The project the CLI acts on: --project, else ORBLE_PROJECT, else "" (the account's default)."""
    if PROJECT:
        return PROJECT[1]
    env = os.environ.get("ORBLE_PROJECT", "")
    return env if PROJECT_RE.fullmatch(env) else ""


def viewer():
    return next((v for v in VIEWERS if shutil.which(v)), "")


def status():
    out = {"ok": True, "error": "", "authError": False, "account": None, "boxes": [], "snapshots": [],
           "snapshotsSupported": False, "keys": [], "localKeys": [], "viewer": viewer(),
           "project": current_project(), "projects": [], "projectMissing": False}
    if not os.access(CLI, os.X_OK):
        out.update(ok=False, error="The orble CLI isn't installed (see orble.tech/docs)")
        print(json.dumps(out))
        return
    if not signed_in():
        out.update(ok=False, authError=True, error="Not signed in to Orble")
        print(json.dumps(out))
        return
    calls = {"help": ["--help"], "ls": ["ls", "--json"], "snapshots": ["snapshots", "--json"], "account": ["account"],
             "keys": ["keys"], "projects": ["project", "list"]}
    with ThreadPoolExecutor(len(calls)) as ex:
        futures = {k: ex.submit(cli, v, 30) for k, v in calls.items()}
        res = {k: f.result() for k, f in futures.items()}

    # Projects (CLI 4af3402c): boxes, private snapshots, networks and secrets belong to one.
    _, help_out, help_err = res["help"]
    code, text, _ = res["projects"]
    if code == 0 and re.search(r"^  project ", help_out + help_err, re.M):
        out["projects"] = parse_projects(text)
    code, text, err = res["ls"]
    if code != 0:
        # The picked project was deleted, or ORBLE_PROJECT names another account's.
        missing = bool(out["project"]) and "project not found" in (err + text).lower()
        out.update(ok=False, authError=code == 3, projectMissing=missing,
                   error=(last_lines(err, text) or f"exit {code}")[:300])
        print(json.dumps(out))
        return
    boxes = parse_boxes_json(text)
    if boxes is None:
        # A CLI from before `ls --json` (or one that changed it): read the table instead.
        code, text, err = cli(["ls"], 30)
        if code != 0:
            out.update(ok=False, authError=code == 3, error=(last_lines(err, text) or f"exit {code}")[:300])
            print(json.dumps(out))
            return
        boxes = parse_boxes(text)
    out["boxes"] = boxes
    out["modernCli"] = bool(re.search(r"^  resize ", help_out + help_err, re.M))
    out["keepAwakeSupported"] = bool(re.search(r"^  keep-awake ", help_out + help_err, re.M))
    code, text, _ = res["snapshots"]
    snaps = parse_snapshots_json(text) if code == 0 else None
    if snaps is not None:
        # A CLI from before snapshots (a456dba3) prints its help instead of JSON.
        out["snapshots"], out["snapshotsSupported"] = snaps, True
    code, text, _ = res["account"]
    if code == 0:
        out["account"] = parse_account(text)
    code, text, _ = res["keys"]
    if code == 0:
        out["keys"] = parse_keys(text)
    out["localKeys"] = local_keys({k["fingerprint"] for k in out["keys"]})
    print(json.dumps(out))


# ---------- actions ----------

def notify(title, body, urgent=False):
    cmd = shutil.which("omarchy-notification-send")
    if cmd:
        args = [cmd, "--app-name", "Orble", "-g", "\U000F048B", "-u", "critical" if urgent else "normal", title, body]
    else:
        args = ["notify-send", "-a", "Orble", title, body]
    try:
        subprocess.run(args, timeout=10)
    except Exception:
        pass


def check_name(v):
    if not NAME_RE.match(v or ""):
        raise SystemExit(f"invalid box name: {v!r}")
    return v


def check_fp(v):
    if not FP_RE.match(v or ""):
        raise SystemExit(f"invalid key fingerprint: {v!r}")
    return v


def check_keyfile(v):
    """A .pub file directly in ~/.ssh (after resolving links)."""
    if not KEYFILE_RE.match(v or ""):
        raise SystemExit(f"invalid key file: {v!r}")
    path = os.path.join(SSH_DIR, v)
    real = os.path.realpath(path)
    if os.path.dirname(real) != os.path.realpath(SSH_DIR) or not os.path.isfile(real):
        raise SystemExit(f"not a public key in ~/.ssh: {v!r}")
    return path


SIZES = ("micro", "s", "m", "l")


def check_size(v):
    if v not in SIZES:
        raise SystemExit("size must be micro, s, m or l")
    return v


def check_count(v):
    if not re.fullmatch(r"\d{1,2}", v or "") or not 1 <= int(v) <= 10:
        raise SystemExit("fork count must be 1 to 10")
    return str(int(v))


def check_port(v):
    if not re.fullmatch(r"\d{1,5}", v or "") or not 1 <= int(v) <= 65535:
        raise SystemExit("port must be 1 to 65535")
    return str(int(v))


def check_dollars(v):
    if not re.fullmatch(r"\d{2,3}", v or "") or not 10 <= int(v) <= 500:
        raise SystemExit("top-up must be whole dollars, 10 to 500")
    return str(int(v))


ONE_ARG = {
    # verb: (argv builder, timeout seconds, success text)
    "suspend": (lambda b: ["suspend", b], 180, "{b} suspended"),
    "resume": (lambda b: ["resume", b], 180, "{b} resumed"),
    "start": (lambda b: ["start", b], 180, "{b} started"),
    "rm": (lambda b: ["rm", b, "-y"], 180, "{b} and its disk deleted"),
    "vnc": (lambda b: ["vnc", b], 180, "Opening the desktop of {b} in your browser"),
    "desktop-off": (lambda b: ["desktop", b, "--off"], 120, "Desktop on {b} turned off"),
    # Server-side: the box stays up while this machine is off. A suspended box resumes.
    "keep-awake": (lambda b: ["keep-awake", b], 180, "{b} kept awake"),
    "keep-awake-off": (lambda b: ["keep-awake", b, "off"], 60, "{b} suspends when idle again"),
}

# A CLI without a command prints this help and exits 0.
HELP_BANNER = "Orble · Sandboxes for AI agents"


def credit():
    code, text, _ = cli(["account"], 30)
    return parse_account(text)["creditUSD"] if code == 0 else None


SECRET_RE = re.compile(r"^[A-Z_][A-Z0-9_]{0,63}$")
DOMAIN_RE = re.compile(r"(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$", re.I)
HEADER_RE = re.compile(r"^[A-Za-z][A-Za-z0-9-]{0,63}$")


def check_rule(entry):
    domain = entry.removeprefix("*.")
    if DOMAIN_RE.fullmatch(domain) and not domain.rsplit(".", 1)[-1].isdigit():
        return entry
    try:
        if not re.fullmatch(r"[0-9]{1,3}(?:\.[0-9]{1,3}){3}(?:/[0-9]{1,2})?", entry):
            raise ValueError()
        ipaddress.IPv4Network(entry, strict=False)
    except ValueError:
        raise ValueError("Use an IPv4 address, CIDR, domain, or wildcard domain") from None
    return entry


def secret_name(name):
    if not SECRET_RE.fullmatch(name):
        raise SystemExit("Use an uppercase environment variable name")
    return name


def secret_set(argv):
    """secret-set NAME HOSTS HEADER FORMAT MODE [box...]. HOSTS is comma-separated (the first one
    is the $NAME_URL gateway's); an empty HEADER or FORMAT leaves it to Orble's default for the host."""
    name, hosts, header, template, mode, *boxes = argv
    secret_name(name)
    host_list = hosts.split(",")
    if not 1 <= len(host_list) <= 20 or len(set(host_list)) != len(host_list) \
            or not all(DOMAIN_RE.fullmatch(h) for h in host_list):
        raise SystemExit("Invalid destination host")
    if header and not HEADER_RE.fullmatch(header):
        raise SystemExit("Invalid HTTP header")
    if template and (len(template) > 100 or template.count("{}") != 1 or not template.isascii() or not template.isprintable()):
        raise SystemExit("The value format must contain exactly one {}")
    if mode not in ("scoped", "all", "scoped-intercept", "all-intercept"):
        raise SystemExit("Invalid secret scope")
    if bool(boxes) != mode.startswith("scoped") or len(boxes) != len(set(boxes)) or len(boxes) > 100:
        raise SystemExit("Choose specific boxes or explicitly choose all boxes")
    if not sys.stdin.isatty():
        raise SystemExit("Open secret entry in a terminal")
    if not signed_in():
        raise SystemExit("Sign in to Orble first")
    args = ["secret", "set", name]
    for host in host_list:
        args.extend(["--host", host])
    if header:
        args.extend(["--header", header])
    if template:
        args.extend(["--format", template])
    for box in boxes:
        args.extend(["--box", check_name(box)])
    if mode.endswith("-intercept"):
        args.append("--intercept")
    where = f" in project {PROJECT[1]}" if PROJECT else ""
    in_terminal(f"Set {name} for {', '.join(host_list)}{where}", args, always=True)


def parse_egress(text):
    mode, *rules = text.strip().splitlines()
    if mode not in ("open", "blocked") or len(rules) > 100:
        raise ValueError()
    entries = []
    for row in rules:
        kind, entry = row.split()
        if kind not in ("allow", "deny"):
            raise ValueError()
        entries.append({"kind": kind, "entry": check_rule(entry)})
    return {"mode": mode, "rules": entries}


def parse_networks(text):
    if re.fullmatch(r"No (?:box )?networks(?:[. ].*)?", text.strip(), re.I):
        return []
    lines = text.rstrip().splitlines()
    if not 1 <= len(lines) <= 510:
        raise ValueError()
    networks = []
    for line in lines:
        first, second = line.split()
        if line[0].isspace():
            current = networks[-1]
            ipaddress.IPv4Address(first)
            box, _, suffix = second.partition(".")
            if not NAME_RE.fullmatch(box) or suffix != current["name"] + ".internal":
                raise ValueError()
            current["members"].append({"box": box, "ip": first, "host": second})
        else:
            ipaddress.IPv4Network(second)
            if not NAME_RE.fullmatch(first):
                raise ValueError()
            networks.append({"name": first, "cidr": second, "members": []})
    if not networks or len(networks) > 10 or any(len(n["members"]) > 50 for n in networks):
        raise ValueError()
    return networks


def parse_secrets(text):
    """`orble secret ls`, one secret per line (CLI 4af3402c):
    'GH_TOKEN  api.github.com,github.com  all boxes in project  intercept' or 'OH_KEY  example.com  k7kq, pqz3'.
    Boxes are their stable names. Empty: 'no secrets'."""
    if re.fullmatch(r"No secrets(?:[. ].*)?", text.strip(), re.I):
        return []
    lines = text.strip().splitlines()
    if not 1 <= len(lines) <= 50:
        raise ValueError()
    secrets = []
    for row in lines:
        cells = re.split(r"\s{2,}", row.strip())
        intercept = len(cells) == 4 and cells[3] == "intercept"
        if len(cells) != 3 and not intercept:
            raise ValueError()
        name, hosts, scope = cells[:3]
        host_list = hosts.split(",")
        if not SECRET_RE.fullmatch(name) or not 1 <= len(host_list) <= 20 \
                or not all(DOMAIN_RE.fullmatch(h) for h in host_list):
            raise ValueError()
        all_boxes = scope.lower() in ("all boxes in project", "all boxes", "all")
        boxes = [] if all_boxes else re.split(r",\s*", scope)
        if not all(NAME_RE.fullmatch(b) for b in boxes):
            raise ValueError()
        secrets.append({"name": name, "hosts": host_list, "boxes": boxes, "all": all_boxes, "intercept": intercept})
    return secrets


def detail(kind, target, demo):
    actions = {
        "egress": (["net", target], parse_egress, "blocked\nallow  example.com"),
        "networks": (["net", "ls"], parse_networks, "build  10.240.0.0/24\n  10.240.0.2  k7f2.build.internal"),
        "secrets": (["secret", "ls"], parse_secrets,
                    "EXAMPLE_KEY  api.example.com  m3qa\nGH_TOKEN  api.github.com,github.com  all boxes in project  intercept"),
    }
    if kind not in actions or (kind == "egress") != bool(target):
        raise SystemExit("Invalid detail request")
    if target:
        check_name(target)
    args, parse, example = actions[kind]
    result = {"kind": kind, "target": target, "ok": False, "error": ""}
    if not demo and not signed_in():
        result["error"] = "Sign in to Orble first."
    else:
        code, out, err = (0, example, "") if demo else cli(args, 25)
        message = (err + out).lower()
        if code == 3:
            result["error"] = "Sign in to Orble again."
        elif "orble · sandboxes for ai agents" in message:
            result["error"] = "Update CLI to use this feature."
        elif code and re.search(r"\bpro\b", message):
            result["error"] = "This feature requires Orble Pro."
        elif code:
            result["error"] = "Orble could not load this section. Try refreshing."
        else:
            try:
                result["data"] = parse(out)
                result["ok"] = True
            except (ValueError, IndexError):
                result["error"] = "The CLI returned an unrecognized response. Update CLI or try again."
    print(json.dumps(result))


def extended_action(verb, rest):
    if verb == "new-named" and len(rest) == 2:
        return ["new", "-s", check_size(rest[0]), "--name", check_name(rest[1])]
    if verb in ("rename", "snapshot-rename", "resize") and len(rest) == 2:
        target = check_name(rest[0])
        if verb == "resize":
            size = check_size(rest[1])
            if size != "micro":
                return ["resize", target, size]
        else:
            prefix = ["rename"] if verb == "rename" else ["snapshot", "rename"]
            return [*prefix, target, check_name(rest[1])]
    if verb == "port-private" and len(rest) == 2:
        return ["port", check_name(rest[0]), check_port(rest[1]), "--private"]
    if verb in ("net-block", "net-open", "net-create", "net-delete") and len(rest) == 1:
        return ["net", verb[4:], check_name(rest[0])]
    if verb in ("net-join", "net-leave") and len(rest) == 2:
        return ["net", verb[4:], *map(check_name, rest)]
    if verb in ("net-allow", "net-deny", "net-rm") and len(rest) == 2:
        try:
            entry = check_rule(rest[1])
        except ValueError as e:
            raise SystemExit(str(e)) from None
        return ["net", verb[4:], check_name(rest[0]), entry]
    if verb == "secret-rm" and len(rest) == 1:
        return ["secret", "rm", secret_name(rest[0])]
    if verb == "secret-copy" and len(rest) == 2:
        slugs = rest[1].split(",")
        if not 1 <= len(slugs) <= 20 or len(set(slugs)) != len(slugs) \
                or not all(PROJECT_RE.fullmatch(p) for p in slugs):
            raise SystemExit("invalid project slug")
        return ["secret", "copy", secret_name(rest[0]), "--to", ",".join(slugs)]
    if verb == "project-create" and len(rest) == 1:
        if not PROJECT_NAME_RE.fullmatch(rest[0]):
            raise SystemExit("Project names are 1 to 40 letters, digits, spaces, dots, dashes or underscores")
        PROJECT.clear()  # a project is made for the account, whichever one is picked
        return ["project", "create", rest[0]]
    return None


def action(argv):
    if not argv:
        raise SystemExit("action needs a verb")
    verb, rest = argv[0], argv[1:]
    if verb in ONE_ARG and len(rest) == 1:
        build, timeout, ok = ONE_ARG[verb]
        b = check_name(rest[0])
        args, text = build(b), ok.format(b=b)
    elif verb == "new" and len(rest) <= 1:
        args, timeout, text = ["new"], 300, "New box ready"
        if rest:
            args += ["-s", check_size(rest[0])]
    elif verb == "new-from" and len(rest) in (1, 2):
        n = check_name(rest[0])
        args, timeout, text = ["new", "--from", n], 300, f"New box from {n} ready"
        if len(rest) == 2:
            args += ["-s", check_size(rest[1])]
    elif verb == "snapshot" and len(rest) in (1, 2):
        b = check_name(rest[0])
        args, timeout, text = ["snapshot", b], 600, f"Saved {b}"
        if len(rest) == 2:
            args.append(check_name(rest[1]))
    elif verb == "snapshot-rm" and len(rest) == 1:
        # Without -y the CLI asks [y/N], reads EOF, says "Kept it." and still exits 0.
        n = check_name(rest[0])
        args, timeout, text = ["snapshot", "rm", n, "-y"], 120, f"Snapshot {n} deleted"
    elif verb in ("port", "port-public", "port-off") and len(rest) == 2:
        b, p = check_name(rest[0]), check_port(rest[1])
        args, timeout = ["port", b, p], 120
        if verb == "port-public":
            args.append("--public")
        elif verb == "port-off":
            args.append("--off")
        text = f"{b}:{p} unshared" if verb == "port-off" else f"{b}:{p} shared"
    elif verb == "fork" and len(rest) in (1, 2):
        b = check_name(rest[0])
        n = check_count(rest[1]) if len(rest) == 2 else "1"
        args, timeout, text = ["fork", b, "-n", n], 600, f"Forked {b}"
    elif verb == "keys-add" and len(rest) == 1:
        path = check_keyfile(rest[0])
        args, timeout, text = ["keys", "add", path], 60, f"SSH key {rest[0]} added"
    elif verb == "keys-rm" and len(rest) == 1:
        fp = check_fp(rest[0])
        args, timeout, text = ["keys", "rm", fp], 60, f"SSH key {fp[:15]}… removed"
    elif verb == "update" and not rest:
        args, timeout, text = ["update"], 300, ""
    elif verb == "logout" and not rest:
        args, timeout, text = ["logout"], 30, "Signed out of Orble"
    else:
        args = extended_action(verb, rest)
        if args is None:
            raise SystemExit(f"unknown action or invalid arguments: {verb}")
        timeout, text = 300, "Orble updated: " + verb.replace("-", " ")
        if verb == "project-create":
            text = f"Project {rest[0]} created"
        elif verb == "secret-copy":
            text = f"Copied {rest[0]} to {rest[1]}"

    if not signed_in():
        notify(f"Orble: {verb} failed", "Not signed in. Use Sign in in the panel, or run orble login.", urgent=True)
        sys.exit(3)
    if verb in ("new", "new-named", "new-from", "fork"):
        # With no credit, `orble new` offers a top-up at a [Y/n] prompt; never get there off a terminal.
        c = credit()
        if c is not None and c <= 0:
            notify("Orble: no credit", "Add credit before creating a box (Add credit in the panel, or orble topup).", urgent=True)
            sys.exit(5)

    code, out, err = cli(args, timeout)
    if code == 0 and verb != "update" and HELP_BANNER in out:
        notify(f"Orble: {verb} failed", "This Orble CLI doesn't have that command. Update it (Update CLI in the panel, or orble update).", urgent=True)
        sys.exit(2)
    if code == 0:
        if verb in ("new", "new-named", "new-from"):
            m = re.search(r"\b([A-Za-z0-9][A-Za-z0-9._-]{0,62}) ready\b(.*)", out)
            text = f"{m[1]} ready{m[2].rstrip()}" if m else text
        elif verb == "fork":
            names = re.findall(r"\b([A-Za-z0-9][A-Za-z0-9._-]{0,62}) ready\b", out)[:10]
            text = f"{text} → {', '.join(names)}" if names else text
        elif verb == "update":
            text = last_lines(out, n=1) or "Orble CLI updated"
        elif verb == "snapshot":
            # "✓ saved nvbg as plugin-test m 4c/8g, 409 MB, in 1.13s"
            m = re.search(r"saved (\S+) as (\S+)(.*)", out)
            text = f"Saved {m[1]} as {m[2]}{m[3].rstrip()}" if m else text
        elif verb in ("port", "port-public"):
            url = next((w for w in out.split() if PORT_URL_RE.match(w)), "")
            text = f"{text}{' (anyone with the address)' if verb == 'port-public' else ''}: {url}" if url else text
        notify("Orble", text[:200])
    else:
        message = "Orble could not remove this secret. Refresh the list and try again." if verb == "secret-rm" else last_lines(err, out)
        notify(f"Orble: {verb} failed", message or f"exit {code}", urgent=True)
    sys.exit(code)


def ports(box):
    b = check_name(box)
    out = {"ok": True, "error": "", "box": b, "ports": []}
    if not signed_in():
        out.update(ok=False, error="Not signed in to Orble")
    else:
        code, text, err = cli(["port", b], 30)
        if code == 0:
            out["ports"] = parse_ports(text)
        else:
            out.update(ok=False, error=(last_lines(err, text) or f"exit {code}")[:300])
    print(json.dumps(out))


# ---------- terminal commands (run inside omarchy-launch-tui) ----------

def hold(code, always=False):
    if code != 0 or always:
        print(f"\n{'Done' if code == 0 else f'orble exited with {code}'}. Press Enter to close.")
        try:
            input()
        except EOFError:
            pass
    sys.exit(code)


def in_terminal(title, args, always=False):
    print(f"\033[1mOrble\033[0m · {title}", flush=True)
    try:
        code = subprocess.call([CLI, *PROJECT, *args], env=dict(os.environ))
    except OSError as e:
        print(f"Could not run orble: {e}")
        code = 127
    hold(code, always)


def exit_node(argv):
    flags, boxes = [], []
    for a in argv:
        if a in ("--lan", "--fallback"):
            if a in flags:
                raise SystemExit(f"exit-node: {a} given twice")
            flags.append(a)
        else:
            b = check_name(a)
            if b in boxes:
                raise SystemExit(f"exit-node: {b} given twice")
            boxes.append(b)
    if len(boxes) > 20:
        raise SystemExit("exit-node: at most 20 boxes")
    if not signed_in():
        print("Not signed in to Orble", flush=True)
        sys.exit(3)
    sys.stdout.flush()
    os.execve(CLI, [CLI, *PROJECT, "exit-node", *flags, *boxes], ENV)


# ---------- demo data (the panel's "Demo data" setting; for screenshots) ----------

def demo_status():
    def box(name, state, c, g, spent, active, flags=(), awake=False):
        return {"name": name, "state": state, "host": f"{name}.quiet-otter.orble.tech",
                "size": SIZE_CLASS.get((c, g), ""), "vcpus": c, "memGiB": g,
                "spentUSD": spent, "active": active, "flags": list(flags), "keepAwake": awake}

    fp = lambda c: "SHA256:" + (c * 43)
    print(json.dumps({
        "ok": True, "error": "", "authError": False, "demo": True, "viewer": "xtigervncviewer",
        "account": {"email": "you@example.com", "domain": "quiet-otter", "creditUSD": 7.42, "keys": 2},
        "boxes": [
            box("k7f2", "running", 2, 4, 0.0412, "now", ["desktop"]),
            box("m3qa", "running", 2, 4, 0.0086, "2m ago", awake=True),
            box("x9pd", "suspended", 2, 4, 0.1931, "3d ago"),
        ],
        "snapshots": [
            {"name": "k7f2-base", "box": "k7f2", "state": "ready", "size": "s", "vcpus": 2, "memGiB": 4,
             "disk": "1.2 GB", "created": "2d ago"},
        ],
        "snapshotsSupported": True, "modernCli": True, "keepAwakeSupported": True,
        "project": current_project(), "projectMissing": False,
        "projects": [{"slug": "default", "name": "Default"}, {"slug": "client-work", "name": "Client work"}],
        "keys": [{"name": "laptop", "fingerprint": fp("A")}, {"name": "desktop", "fingerprint": fp("B")}],
        "localKeys": [
            {"file": "id_ed25519.pub", "fingerprint": fp("A"), "comment": "you@laptop", "type": "ED25519", "added": True},
            {"file": "id_work.pub", "fingerprint": fp("C"), "comment": "you@work", "type": "ED25519", "added": False},
        ],
    }))


def demo_ports(box):
    b = check_name(box)
    p = [{"port": 3000, "access": "signin", "url": "https://3000-demo0k7f2.orble.dev"}] if b == "k7f2" else []
    print(json.dumps({"ok": True, "error": "", "box": b, "ports": p}))


def demo_exit_node(argv):
    names = [a for a in argv if not a.startswith("--")]
    stop = []
    signal.signal(signal.SIGINT, lambda *_: stop.append(1))
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    who = ", ".join(names) if names else "The boxes switched on in the dashboard"
    print(f"Exit node connected from 203.0.113.7. {who} now use this machine's network.", flush=True)
    while not stop:
        time.sleep(0.2)
    print("Exit node off. The boxes are back on Orble's network.", flush=True)


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["--project"]:
        if len(argv) < 2 or not PROJECT_RE.fullmatch(argv[1]):
            raise SystemExit("invalid project slug")
        PROJECT[:] = argv[:2]
        argv = argv[2:]
    if not argv:
        print(__doc__)
        sys.exit(2)
    cmd, rest = argv[0], argv[1:]
    demo = rest[-1:] == ["--demo"]
    if cmd == "detail" and len(rest) - int(demo) in (1, 2):
        args = rest[:-1] if demo else rest
        detail(args[0], args[1] if len(args) == 2 else "", demo)
    elif demo and cmd == "status":
        demo_status()
    elif demo and cmd == "ports" and len(rest) == 2:
        demo_ports(rest[0])
    elif demo and cmd == "exit-node":
        demo_exit_node(rest[:-1])
    elif cmd == "status":
        status()
    elif cmd == "ports" and len(rest) == 1:
        ports(rest[0])
    elif cmd == "secret-set" and not demo and len(rest) >= 5:
        try:
            secret_set(rest)
        except SystemExit as e:
            if not isinstance(e.code, str) or not sys.stdin.isatty():
                raise
            print(e.code)
            hold(2)
    elif cmd == "action" and not demo:
        action(rest)
    elif cmd == "exit-node":
        exit_node(rest)
    elif cmd == "ssh" and len(rest) == 1:
        b = check_name(rest[0])
        in_terminal(f"ssh {b} (a suspended box resumes)", ["ssh", b])
    elif cmd == "desktop" and len(rest) == 1:
        b = check_name(rest[0])
        if not viewer():
            print("No VNC viewer found. Install tigervnc (xtigervncviewer) or remmina, or use the browser desktop.")
            hold(1)
        in_terminal(f"desktop of {b} in a VNC viewer (close this window to end it)", ["desktop", b])
    elif cmd == "topup" and len(rest) == 1:
        d = check_dollars(rest[0])
        in_terminal(f"add ${d} of credit", ["topup", d], always=True)
    elif cmd == "port-token" and not demo and len(rest) == 2:
        b, p = check_name(rest[0]), check_port(rest[1])
        in_terminal(f"share {b}:{p} with a preview token", ["port", b, p, "--token"], always=True)
    elif cmd == "port-new-token" and not demo and len(rest) == 2:
        b, p = check_name(rest[0]), check_port(rest[1])
        in_terminal(f"replace preview token for {b}:{p}", ["port", b, p, "--new-token"], always=True)
    elif cmd == "login" and not rest:
        in_terminal("sign in with Google or GitHub", ["login"], always=True)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
